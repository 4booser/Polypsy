/*
 * Отдельная конфигурация для тестов, а не общая.
 *
 * Проверка типов должна покрывать тесты, но сборка образа консоли — нет:
 * образ ставит только то, что нужно приложению, и типы bun-types туда не
 * попадают. Общая конфигурация означала бы либо непроверенные тесты, либо
 * лишнюю зависимость в боевом образе. Сборка при этом падала уже в Docker,
 * а локально была зелёной.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "bun-types"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "test"
  ]
}
