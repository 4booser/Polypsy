# Раздача консоли + прокси API. TLS Caddy берёт на себя, если задан домен.
#
# Блок глобальных настроек с почтой учётной записи ACME дописывает entry.sh —
# и только когда почта задана: `email` без значения Caddy не принимает вовсе
# («wrong argument count»), и конфиг перестаёт разбираться.
#
# SITE_ALIASES — дополнительные имена того же сайта, через пробел. Нужны они
# не для красоты: Let's Encrypt считает предел выдачи на ТОЧНЫЙ набор имён, и
# набор из двух имён — это другой счётчик. Когда предел на одно имя выбран
# (пять сертификатов за неделю — ровно то, что случилось, пока каждая выкатка
# пересоздавала сертификат заново), добавление второго имени возвращает сайт
# сегодня, а не через сутки ожидания.
{$SITE_ADDRESS::80} {$SITE_ALIASES:} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3001
	}

	# Здоровье приложения наружу. Без этого снаружи его не спросить: сюда
	# проксируется только /api/*, а /health у сервера лежит в корне — и
	# запрос к нему попадал в раздачу статики, которая на любой неизвестный
	# путь честно отдаёт index.html с кодом 200. Проверка после выкатки при
	# этом «проходила» всегда, включая случай упавшего API.
	handle /health* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
