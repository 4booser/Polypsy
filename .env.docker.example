# Обязательные
POSTGRES_PASSWORD=смените-меня
# Пароль роли приложения. Она НЕ владеет таблицами — только для такой роли
# действуют политики строк. Сгенерировать: head -c 24 /dev/urandom | base64
APP_DB_PASSWORD=смените-меня-тоже
JWT_SECRET=случайная-строка-минимум-32-символа-обязательно

# Шифрование чувствительных полей. Без него ФИО, дата рождения, телефон,
# свободные ответы, заключения, заметки приёма, планы безопасности,
# переписка и стенограммы приёмов лежат в базе ОТКРЫТЫМ ТЕКСТОМ: дамп,
# бэкап или доступ администратора базы раскрывают карты целиком. Поэтому
# пустое значение не принимается — процесс не стартует.
#
# Сгенерировать:  echo "v1:$(head -c 32 /dev/urandom | base64)"
# Ротация: добавить новый ключ ПЕРВЫМ через запятую, старый оставить для
# чтения, затем прогнать bun run --cwd apps/api db:encrypt
#
# Ключ хранится ВНЕ базы и попадает в резервное копирование отдельно: бэкап
# вместе с ключом равнозначен бэкапу без шифрования.
ENCRYPTION_KEY=

# Слепой индекс телефона: по нему система видит, что человек уже
# зарегистрирован, не расшифровывая номер. Отдельный секрет, а НЕ JWT_SECRET:
#  — утечка секрета подписи (он есть в окружении каждого процесса, в CI, в
#    отладочных выгрузках) при общем значении означала бы, что телефоны из
#    дампа восстанавливаются перебором за минуты;
#  — ротация JWT_SECRET, штатная реакция на утечку, молча ломала бы
#    дедупликацию: «номер уже используется» перестало бы срабатывать.
# Смена ЭТОГО секрета делает прежние индексы несравнимыми — после смены
# прогнать: bun run --cwd apps/api db:reindex-phones
# Сгенерировать: head -c 32 /dev/urandom | base64
PHONE_INDEX_SECRET=

# Коды субъекта и наблюдения в научных выгрузках. Тоже отдельный секрет:
# код субъекта обязан быть стабильным годами (на нём склеивается лонгитюд),
# а секрет подписи сессий положено менять при подозрении на утечку. Смена
# этого секрета меняет коды: датасеты, выгруженные до неё, с новыми не
# склеятся — это неустранимо, коды живут в уже отданных файлах.
# Сгенерировать: head -c 32 /dev/urandom | base64
EXPORT_SECRET=

# Домен консоли (для TLS). Пусто — работа по http на :80
SITE_ADDRESS=

# Origins для CORS: адрес консоли. При работе через Caddy тот же origin,
# поэтому обычно совпадает с SITE_ADDRESS (или http://<ip>)
CORS_ORIGINS=

# Порты наружу
HTTP_PORT=80
HTTPS_PORT=443

# SMTP для уведомлений о тревогах: smtp://user:pass@host:587
# Пусто — тревоги видны только в консоли, отправка фиксируется в журнале как none
SMTP_URL=
MAIL_FROM=Quizzy <noreply@example.org>
# Адрес консоли — попадает в ссылки писем
CONSOLE_URL=

# Оповещения техпанели о работе системы (/ops/alerts): 5xx, планировщик,
# p95, место на диске. Токен бота — от @BotFather, чат — куда бот добавлен.
# Почта — тем же SMTP_URL; адресаты через запятую, пусто — суперадмины.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_ALERT_EMAIL=

# ── Запись приёмов голосом ───────────────────────────────────────────────────
# Модель распознавания whisper.cpp. Качается один раз в том, не в образ.
#   tiny   ~75 МБ   — для украинского и русского непригодна
#   base   ~142 МБ  — слабо
#   small  ~466 МБ  — рабочий минимум, значение по умолчанию
#   medium ~1.5 ГБ  — заметно лучше, примерно втрое медленнее
WHISPER_MODEL_NAME=small
# Сколько ядер отдать расшифровке. Остальное остаётся консоли: расшифровка
# часового приёма занимает минуты, и без ограничения она съедает машину.
TRANSCRIBER_CPUS=2

# Ретенция сырого потока событий ответов (answer_events), дней. 0 — вечно.
# Агрегаты (время на пункт, переключения) остаются в answers навсегда.
ANSWER_EVENTS_RETENTION_DAYS=365

# Шапка печатных документов: отчёт подшивается в дело, и лист без шапки —
# просто распечатка, а не документ.
INSTITUTION_NAME=
INSTITUTION_UNIT=

# ── Вход через Google ────────────────────────────────────────────────────────
# Дополнительный способ входа, а не замена паролю. Пусто — способа нет и
# кнопки нет. Заводится в console.cloud.google.com → Credentials → OAuth
# client ID (Web application).
#
# Адрес возврата должен совпасть посимвольно с тем, что вписан в Google —
# расхождение даёт redirect_uri_mismatch, самую частую ошибку здесь.
#
# Пациентам этот способ не предлагается: обращение к Google сообщает ему, что
# человек посещает психологическое отделение, а учётную запись под кодом
# связать с Google нельзя вовсе — сервер откажет.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Домены почты через запятую; пусто — любые. Для персонала лучше указать свой
GOOGLE_ALLOWED_DOMAINS=

# Почта учётной записи Let's Encrypt.
#
# На неё приходят предупреждения за две недели до истечения сертификата.
# Пусто — учётная запись без контакта: предупреждение не придёт никуда, и о
# просроченном сертификате учреждение узнает от пациента, который не смог
# открыть систему.
ACME_EMAIL=
