# Обязательные
POSTGRES_PASSWORD=смените-меня
JWT_SECRET=случайная-строка-минимум-32-символа-обязательно

# Домен консоли (для TLS). Пусто — работа по http на :80
SITE_ADDRESS=

# Origins для CORS: адрес консоли. При работе через Caddy тот же origin,
# поэтому обычно совпадает с SITE_ADDRESS (или http://<ip>)
CORS_ORIGINS=

# Порты наружу
HTTP_PORT=80
HTTPS_PORT=443
