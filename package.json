{
  "name": "quizzy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "bun run --cwd apps/api dev",
    "mobile": "bun run --cwd apps/mobile start",
    "db:seed": "bun run --cwd apps/api db:seed",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/mobile typecheck && bun run --cwd apps/web typecheck",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "web": "bun run --cwd apps/web dev",
    "test": "bun test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "install:instance": "bun run --cwd apps/api install:instance"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.7.3"
  }
}
