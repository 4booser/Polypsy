diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..30abfdbdbbd4dc23e230f4cffafbc0ed63f013c3 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -178,6 +178,15 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         && sent.length < max_pipeline
         && (!q.options.onexecute || q.options.onexecute(connection))
     } catch (error) {
+      // The message for q could not be built (parameter ceiling, undefined or
+      // unserializable value), so nothing of q went out. If q waits in `sent`
+      // behind a query in flight, reject q itself and drop it from `sent`:
+      // errored() would reject the query in flight instead and leave q waiting
+      // for a reply that never comes, shifting every later reply onto the
+      // previous query (a transaction then hangs on its ROLLBACK forever).
+      if (sent.remove(q))
+        return (queryError(q, error), true)
+
       sent.length === 0 && write(Sync)
       errored(error)
       return true
